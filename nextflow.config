params {
    // -------------------------------------------------------------------------
    // Pipeline control
    // -------------------------------------------------------------------------
    skip_process_reads     = false
    skip_make_database_sra = false
    skip_mining_sra        = false
    skip_reformat_sra      = false
    skip_exonerate_sra     = false
    skip_stitcher_sra      = false
    skip_mapping           = false
    skip_consensus         = false
    skip_alignment         = false
    skip_cleaning          = false
    skip_filtering         = false
    skip_partitionfinder   = false
    skip_mrbayes           = false
    skip_datasets          = false

    // -------------------------------------------------------------------------
    // Containers / tools
    // -------------------------------------------------------------------------
    containers       = "${projectDir}/containers"
    helper_scripts   = "${projectDir}/helper-scripts"
    examiner_script  = "${params.helper_scripts}/ExAMiner/ExAMiner.py"
    physsu_script    = "${params.helper_scripts}/physsu.R"
    datagene_script  = "${params.helper_scripts}/datagene.R"

    // -------------------------------------------------------------------------
    // Reference data
    // -------------------------------------------------------------------------
    ref_tax          = "GCA_004193795.1_Asbolus_verrucosus"

    infodir          = "${projectDir}/../../1-info"
    datadir          = "${projectDir}/../../samples"

    samples_list     = "${params.infodir}/samples.txt"
    samples_info     = "${params.infodir}/list.samples.eut_data.info.txt"
    outgroups_list   = "${params.infodir}/list.outgroups.eut_data.txt"

    baits_list       = "${params.infodir}/list.baits.m50M1334.txt"
    baits_stop_dir   = "${params.infodir}/orthofinder/3-baits/${params.ref_tax}/protein/with.stop"
    baits_nostop_dir = "${params.infodir}/orthofinder/3-baits/${params.ref_tax}/protein/without.stop"

    sra_conf         = "${params.infodir}/SRAssembler.conf"

    template_pf_cfg  = "${params.infodir}/template.partition_finder.cfg"

    busco_table      = "${params.infodir}/orthofinder/3-baits/${params.ref_tax}/busco/mzl/run_metazoa_odb10/full_table.tsv"


    // -------------------------------------------------------------------------
    // Output directories
    // -------------------------------------------------------------------------
    outdir                   = "${projectDir}/../../nf_results/"
    processed_reads_dir      = "${params.outdir}/2-processed/"
    sra_db_dir               = "${params.outdir}/3-database.sra/"
    sra_mining_dir           = "${params.outdir}/4-mining.sra/"
    reformer_sra_dir         = "${params.outdir}/5-stitching.sra/"
    exonerate_sra_dir        = "${params.reformer_sra_dir}/5.2-exonerate.output/"
    stitcher_out_dir         = "${params.reformer_sra_dir}/5.3-stitcher.output/"
    mapping_out_dir          = "${params.outdir}/6-mapping/"
    consensus_dir            = "${params.mapping_out_dir}/6.2-consensus/"
    align_dir                = "${params.outdir}/7-aligning/"
    cleaning_dir             = "${params.outdir}/8-cleaning/"
    final_out_dir            = "${params.outdir}/9-final.data/"
    mrbayes_analyses_dir     = "${params.final_out_dir}/mrbayes_analyses"
    partfi_dir               = "${params.mrbayes_analyses_dir}/partfi"
    mrbayes_dir              = "${params.mrbayes_analyses_dir}/mrbayes"
    bi_trees_dir             = "${params.final_out_dir}/trees"
    subsets_dir              = "${params.final_out_dir}/subsets"
    crossval_ml_trees_dir    = "${params.final_out_dir}/trees"
    crossval_alignments_dir  = "${params.final_out_dir}/alignments"
    crossval_stats           = "${params.final_out_dir}/stats/postfilter_stats_ingroup.txt"

    // -------------------------------------------------------------------------
    // Third party tools output directories
    // -------------------------------------------------------------------------

    results_from_third_party = ""
    atram_out_dir     = "${projectDir}/../../aTRAM_stitched_exons/"
    patchwork_out_dir = "${projectDir}/../../results_patchwork/"

    // -------------------------------------------------------------------------
    // PROCESS_READS (fastp)
    // -------------------------------------------------------------------------
    fastp_threads      = 16

    fastp_dup_acc      = 6
    fastp_complexity   = 30

    fastp_trim_front1  = 6
    fastp_trim_front2  = 6
    fastp_trim_window  = 4
    fastp_trim_quality = 20

    fastp_min_length   = 100

    fastp_qual_phred   = 20
    fastp_qual_lim     = 20
    fastp_base_lim     = 0

    // -------------------------------------------------------------------------
    // MINING_SRA safety timeout (per bait)
    // -------------------------------------------------------------------------
    mining_bait_timeout_min = 30

    // -------------------------------------------------------------------------
    // STITCHER_SRA (ExAMiner)
    // -------------------------------------------------------------------------
    // Percentage threshold to consider a partial reference
    examiner_threshold                   = 0.8
    // Score difference to discard an exonerate alignment
    examiner_score                       = 0.15

    // Maximum number of amino-acid mismatches within an overlapping region between
    // two segments that will still be resolved by trimming '(keeping the higher-scoring
    // segment) rather than discarding the whole sample 
    examiner_overlap_mismatch_tolerance  = 0

    // How to resolve a segment overlap that cannot be confidently trimmed (conflicting AA
    // sequences over the mismatch tolerance or tied/unavailable segment scores).
    // "mask" removes the overlapping amino acids from both segments and lets the gap
    // be filled with missing-data characters, keeping the rest of the sample (default)
    // while "discard" drops the whole sample (more conservative)
    examiner_overlap_conflict_resolution = "mask"

    // character used to fill unknown or missing nucleotides in the output alignments
    examiner_missing                     = "N"
    // length of the buffer of Ns to add to both ends in the output for mapping
    examiner_buffer                      = 600

    // -------------------------------------------------------------------------
    // MAPPER (bwa)
    // -------------------------------------------------------------------------
    bwa_threads  = 10
    // Length of the initial mapping seed without mismatch (consider 25% of the read length)
    bwa_seed     = 36
    // Mapping quality to keep a read (0 for no mapping quality filter) - SHARED WITH CONSENSUS STEP
    mapping_mapq = 20
    // Gap open penalties for deletions and insertions
    bwa_indel    = 100
    // Gap extention penalty
    bwa_gapex    = 100

    // -------------------------------------------------------------------------
    // CONSENSUS (samtools)
    // -------------------------------------------------------------------------
    // Minimum depth to consider a base
    samtools_depth   = 4
    // Percent of identical bases to consider a consensus position
    // samtools_cons = 0.85
    // Base quality to consider a base in consensus calling (0 for no base quality filter)
    samtools_baseq   = 0

    // -------------------------------------------------------------------------
    // ALIGNER (macse)
    // -------------------------------------------------------------------------
    // Percentage of Ns allowed as a percent of the bait length
    n_percent = 25
    // Percentage of samples that a bait needs to be present in in order to keep it
    s_percent = 90

    // -------------------------------------------------------------------------
    // CLEANER (seda & iqtree)
    // -------------------------------------------------------------------------
    // Number of sequences in alignment with stop codons
    stop_thresh = 2

    iqtree_runs = 50
    iqtree_boot = 1000

    // -------------------------------------------------------------------------
    // FILTERING (PHYSSUR)
    // -------------------------------------------------------------------------
    // Threshold for average bootstrap support
    phys_boot    = 0
    //Proportion of kept loci after filtering (loci are selected based on clocklikeness score)
    phys_prop    = 1

    // -------------------------------------------------------------------------
    // PARTITIONFINDER / MRBAYES (bayesian gene trees)
    // -------------------------------------------------------------------------
    mb_ngen       = 100000000
    mb_samplefreq = 100
    mb_diagnfreq  = 2000
    mb_stopval    = 0.005

    // -------------------------------------------------------------------------
    // DATASETS
    // -------------------------------------------------------------------------
    crossval_mode       = "--bi"
    crossval_cid_thres  = 0.5
}


// -------------------------------------------------------------------------
// Derived parameters
// -------------------------------------------------------------------------
// Automatically generate a unique output prefix from consensus parameters.
// This ensures results from different consensus settings are written to
// separate directories, while still allowing manual override with --ucode.
if (!params.ucode) {
    params.ucode = "DP${params.samtools_depth}BQ${params.samtools_baseq}_iupac"
}
if (!params.crossval_tag) {
    params.crossval_tag = "c${params.crossval_cid_thres.toString().replace('.', '')}"
}

process {
    executor = 'slurm'
    queue    = 'long'
    killTimeout = '45 sec'

    withLabel: sra_make_db {
        cpus    = 35
        memory  = '100 GB'
        container = "${params.containers}/sra.sif"
        clusterOptions = '--nodes=1 --ntasks=1'
    }

    withLabel: fastp {
        cpus   = params.fastp_threads
        memory = '72 GB'
        container = "${params.containers}/fastp_1.1.0.sif"
    }

    withLabel: gunzip {
        cpus   = 1
        memory = '4 GB'
    }

    withLabel: mining_sra {
        cpus = 35
        memory = '256 GB'
        container = "${params.containers}/sra.sif"
        clusterOptions = '--nodes=1 --ntasks=1 --exclusive --partition=himem'
    }

    // Alternative cluster options:
    // clusterOptions = '--nodes=1 --ntasks=1 --exclusive --partition=long --mem=0'

    withLabel: stitching {
        queue          = 'medium'
        cpus           = 1
        memory         = '8 GB'
        container      = "${params.containers}/exonerate_2.4.0_biopython_numpy.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: local_small {
        executor = 'local'
        cpus     = 1
        memory   = '2 GB'
    }

    withLabel: slurm_small {
        queue     = 'short'
        cpus      = 1
        container = "${params.containers}/samtools_1.24_seqkit_2.13.0.sif"
        memory    = '5 GB'
    }

    withLabel: mapping {
        queue     = 'medium'
        cpus      = params.bwa_threads
        memory    = '5 GB'
        container = "${params.containers}/bwa_0.7.19_samtools_1.24_bamutil_1.0.15.sif"
    }

    withLabel: consensus {
        queue          = 'medium'
        cpus           = 1
        memory         = '5 GB'
        container      = "${params.containers}/samtools_1.24_seqkit_2.13.0.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: aligning {
        queue          = 'medium'
        cpus           = 1
        memory         = '5 GB'
        errorStrategy  = { task.exitStatus in [137, 140, 143] ? 'retry' : 'ignore' }
        maxRetries     = 1
        container      = "${params.containers}/macse_2.07.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: cleaning {
        queue          = 'long'
        cpus           = 4
        memory         = '8 GB'
        container      = "${params.containers}/seda_cleaning.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: filtering {
        queue          = 'short'
        cpus           = 8
        memory         = '5 GB'
        container      = "${params.containers}/filtering.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: partitionfinder {
        queue          = 'short'
        cpus           = 2
        memory         = '8 GB'
        container      = "${params.containers}/partitionfinder_2.1.1_goalign_0.4.1.sif"
        clusterOptions = '--nodes=1'
    }

    withLabel: mrbayes {
        queue          = 'medium'
        cpus           = 1
        memory         = '10 GB'
        container      = "${params.containers}/mrbayes_3.2.7a_goalign_0.4.1_gotree_0.4.5.sif"
        clusterOptions = '--nodes=1'
        errorStrategy  = { task.exitStatus in [137, 140, 143] ? 'retry' : 'ignore' }
        maxRetries     = 1
    }
    
    withLabel: datasets {
        queue          = 'medium'
        cpus           = 1
        memory         = '16 GB'
        container      = "${params.containers}/filtering.sif"
        clusterOptions = '--nodes=1'
    }
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    name = 'slurm'
    exitReadTimeout = '20 min'
}
